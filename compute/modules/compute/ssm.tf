resource "aws_ssm_parameter" "apmix_api_key" {
  name  = "/${var.name_prefix}/apmix-api-key"
  type  = "SecureString"
  value = var.apmix_api_key_value
  # no key_id = uses the AWS-managed key (alias/aws/ssm) automatically

  tags = {
    Name = "${var.name_prefix}-apmix-api-key"
  }

  lifecycle {
    ignore_changes = [value]
  }
}

# The value GitHub Actions uses to trigger the Jenkins pipeline remotely.
# Terraform creates this value once. It is never generated by Jenkins
# itself, so it does not change when the Jenkins instance is replaced.
# GitHub Actions' repo secret is set to this same value one time and never
# has to be touched again.
resource "random_password" "jenkins_trigger_token" {
  length  = 40
  special = false
}

resource "aws_ssm_parameter" "jenkins_trigger_token" {
  name  = "/${var.name_prefix}/jenkins-trigger-token"
  type  = "SecureString"
  value = random_password.jenkins_trigger_token.result

  tags = {
    Name = "${var.name_prefix}-jenkins-trigger-token"
  }

  lifecycle {
    ignore_changes = [value]
  }
}